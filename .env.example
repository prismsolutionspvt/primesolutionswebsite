# Copy to .env.local and fill in. Every variable is optional.
# NEXT_PUBLIC_* values are embedded in the browser bundle and are PUBLIC — never put secrets in them.

# Canonical site origin, no trailing slash (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=

# Contact details — leave blank until confirmed by the client
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# WhatsApp number: digits only, international format. Blank = WhatsApp opens with a contact chooser
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Social profiles
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Backend phase: endpoint that receives enquiry POSTs. Blank = form runs in preview mode (nothing is sent)
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
