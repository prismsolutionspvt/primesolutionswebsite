# Copy to .env.local and fill in. Never commit .env.local (it is git-ignored).
#
# NEXT_PUBLIC_* values are embedded in the browser bundle and are PUBLIC.
# This app never uses (and must never be given) a Supabase service-role / secret key.
# Setup guide: docs/SUPABASE_SETUP.md

# Your Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE key (formerly "anon" key). Safe to expose: Row Level Security decides what it can do.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical site origin, no trailing slash. Only a fallback: the owner can set it in Admin → Website Appearance.
NEXT_PUBLIC_SITE_URL=

# OPTIONAL, server-side only. The e-mail address the sign-in page will send a one-time link to.
# It never grants access (the database does). Defaults to prismsolutions.pvt@gmail.com.
# Keep in sync with supabase/migrations/…_owner_bootstrap.sql if the owner ever changes.
ADMIN_OWNER_EMAIL=

# Contact details, WhatsApp number, Instagram, footer text, theme default, etc. are NOT environment variables any more:
# the owner edits them in the admin panel (/admin).
