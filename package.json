{
  "name": "prism-solutions",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5200",
    "build": "next build",
    "start": "next start -p 5200",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "db:seed:generate": "node scripts/generate-seed.mjs",
    "db:test": "node --test supabase/tests/rls.test.mjs supabase/tests/admin-flow.test.mjs supabase/tests/hardening.test.mjs",
    "db:bundle": "node scripts/bundle-sql.mjs",
    "test:unit": "node --test scripts/unit.test.mjs",
    "test": "npm run test:unit && npm run db:test",
    "audit:links": "node scripts/link-audit.mjs",
    "security:check": "node scripts/security-check.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4",
    "typescript": "5.9"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "framer-motion": "^14.13.0",
    "gsap": "^3.15.1",
    "lucide-react": "^1.72.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "description": "Marketing website for Prism Solutions (Next.js App Router, GSAP).",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    }
  }
}
